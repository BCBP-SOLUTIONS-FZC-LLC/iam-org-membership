# Version control
.git
.gitignore

# Environment files — never bake secrets into the image
.env
.env.*
*.env
.go_private_token

# Development tooling and docs
.claude/
docs/
!docs/swagger/
deploy/
scripts/
*.md
ARCHITECTURE.md
README.md

# Local compose (host-only)
docker-compose.yml
docker-compose.pro.yml

# Test artefacts
test/
coverage.out
coverage.html
*.coverprofile
**/*_test.go

# Build artefacts already compiled outside Docker
bin/
.coverage/

# IDE and OS noise
.idea/
.vscode/
*.DS_Store
*.swp
*.swo

# Go tool cache (not needed in image)
vendor/

{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublishMembershipEvents",
      "Effect": "Allow",
      "Action": [
        "sns:Publish",
        "sns:GetTopicAttributes"
      ],
      "Resource": [
        "${membership_events_topic_arn}",
        "${tenant_events_topic_arn}"
      ]
    },
    {
      "Sid": "ConsumeTenantAndBillingQueues",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:GetQueueAttributes",
        "sqs:ChangeMessageVisibility",
        "sqs:SendMessage"
      ],
      "Resource": [
        "${tenant_orgm_queue_arn}",
        "${tenant_orgm_queue_dlq_arn}",
        "${billing_orgm_queue_arn}",
        "${billing_orgm_queue_dlq_arn}"
      ]
    },
    {
      "Sid": "GlueSchemaRegistryReadOnly",
      "Effect": "Allow",
      "Action": [
        "glue:GetRegistry",
        "glue:GetSchema",
        "glue:GetSchemaVersion",
        "glue:GetSchemaByDefinition",
        "glue:ListSchemas",
        "glue:QuerySchemaVersionMetadata"
      ],
      "Resource": [
        "${membership_registry_arn}",
        "${membership_registry_arn}/*",
        "${membership_schema_arn_prefix}/*",
        "${tenant_registry_arn}",
        "${tenant_registry_arn}/*",
        "${tenant_schema_arn_prefix}/*"
      ]
    },
    {
      "Sid": "CloudWatchMetricsForExporterGoroutines",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricData"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "cloudwatch:namespace": "BCBP/OrgMembership"
        }
      }
    },
    {
      "Sid": "CloudWatchLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:${aws_region}:${aws_account_id}:log-group:/aws/eks/*:*"
    }
  ]
}

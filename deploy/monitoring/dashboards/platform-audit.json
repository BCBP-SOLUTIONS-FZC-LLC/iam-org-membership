        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "platform_audit:delivery_enabled:max{domain=\"$domain\",service=\"$service\",environment=\"$environment\"}",
          "legendFormat": "enabled",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "0 = AUDIT_LOG_BASE_URL not set: entries only accumulate.",
      "links": [
        {
          "title": "Runbook: PlatformAuditDeliveryDisabled",
          "url": "https://github.com/BCBP-SOLUTIONS-FZC-LLC/platform-audit/blob/main/docs/observability/runbook.md#platformauditdeliverydisabled",
          "targetBlank": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "8. Runner heartbeat age",
      "id": 13,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 25
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "up .*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - platform_audit_runner_last_tick_timestamp_seconds{domain=\"$domain\",service=\"$service\",environment=\"$environment\"}",
          "legendFormat": "{{pod}} {{operation}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "B",
          "expr": "platform_audit_runner_up{domain=\"$domain\",service=\"$service\",environment=\"$environment\"}",
          "legendFormat": "up {{pod}} {{operation}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "Per pod; the threshold line is 5 \u00d7 interval (25 s at the defaults). runner_up is overlaid.",
      "links": [
        {
          "title": "Runbook: PlatformAuditRunnerStalled",
          "url": "https://github.com/BCBP-SOLUTIONS-FZC-LLC/platform-audit/blob/main/docs/observability/runbook.md#platformauditrunnerstalled",
          "targetBlank": true
        }
      ]
    },
    {
      "type": "row",
      "title": "Details",
      "id": 14,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Attempts by reason",
      "id": 15,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "platform_audit:deliveries:rate5m{domain=\"$domain\",service=\"$service\",environment=\"$environment\"}",
          "legendFormat": "{{operation}} {{reason}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "",
      "links": [
        {
          "title": "Runbook: PlatformAuditNotAdmitted",
          "url": "https://github.com/BCBP-SOLUTIONS-FZC-LLC/platform-audit/blob/main/docs/observability/runbook.md#platformauditnotadmitted",
          "targetBlank": true
        },
        {
          "title": "Runbook: PlatformAuditUnknownEntryType",
          "url": "https://github.com/BCBP-SOLUTIONS-FZC-LLC/platform-audit/blob/main/docs/observability/runbook.md#platformauditunknownentrytype",
          "targetBlank": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Retries and dead-letters by entry type (shared)",
      "id": 16,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (event_type) (rate(platform_retry_total{domain=\"$domain\",service=\"$service\",environment=\"$environment\",operation=\"audit_deliver\"}[5m]))",
          "legendFormat": "retry {{event_type}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (event_type, reason) (increase(platform_dlq_messages_total{domain=\"$domain\",service=\"$service\",environment=\"$environment\",operation=\"audit_deliver\"}[1h]))",
          "legendFormat": "parked {{event_type}} {{reason}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "description": "",
      "links": [
        {
          "title": "Runbook: PlatformAuditEntriesParked",
          "url": "https://github.com/BCBP-SOLUTIONS-FZC-LLC/platform-audit/blob/main/docs/observability/runbook.md#platformauditentriesparked",
          "targetBlank": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Audit Log call errors (shared) (Proposed)",
      "id": 17,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },

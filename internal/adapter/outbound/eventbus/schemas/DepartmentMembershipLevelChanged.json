{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "DepartmentMembershipLevelChanged",
  "title": "DepartmentMembershipLevelChanged",
  "type": "object",
  "required": ["user_id", "tenant_id", "department_id", "previous_level", "new_level", "actor_id"],
  "properties": {
    "user_id":        { "type": "string", "format": "uuid" },
    "tenant_id":      { "type": "string", "format": "uuid" },
    "department_id":  { "type": "string", "format": "uuid" },
    "previous_level": { "type": "string", "enum": ["preparator","reviewer","approver"] },
    "new_level":      { "type": "string", "enum": ["preparator","reviewer","approver"] },
    "actor_id":       { "type": "string", "format": "uuid" }
  },
  "additionalProperties": false
}

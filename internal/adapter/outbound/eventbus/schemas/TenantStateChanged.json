{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "TenantStateChanged",
  "title": "TenantStateChanged",
  "description": "EVT-16 relay emitted whenever a consumed lifecycle event actually changes tenants.status or tenants.plan. Never emitted on stale-skip or no-op.",
  "type": "object",
  "required": ["tenant_id", "status", "previous_status", "plan", "previous_plan", "changed_at", "cause"],
  "properties": {
    "tenant_id":       { "type": "string", "format": "uuid" },
    "status":          { "type": "string", "enum": ["trial","active","past_due","cancelled","suspended","trial_expired","offboarded"] },
    "previous_status": { "type": "string", "enum": ["trial","active","past_due","cancelled","suspended","trial_expired","offboarded"] },
    "plan":            { "type": "string", "enum": ["starter","pro","enterprise"] },
    "previous_plan":   { "type": "string", "enum": ["starter","pro","enterprise"] },
    "changed_at":      { "type": "string", "format": "date-time" },
    "cause":           { "type": "string" }
  },
  "additionalProperties": false
}

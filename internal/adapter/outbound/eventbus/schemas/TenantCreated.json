{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "TenantCreated",
  "title": "TenantCreated",
  "description": "New tenant row created via I-1 trial signup or the TrialTenantProvisioned consumer path (§8.1). Routes to iam.tenant.events (one of only 2 event types on that topic).",
  "type": "object",
  "required": ["tenant_id", "slug", "plan", "status"],
  "properties": {
    "tenant_id": { "type": "string", "format": "uuid" },
    "slug":      { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,62}[a-z0-9]$" },
    "plan":      { "type": "string", "enum": ["starter", "pro", "enterprise"] },
    "status":    { "type": "string", "enum": ["trial", "active", "past_due", "cancelled", "suspended", "trial_expired", "offboarded"] }
  },
  "additionalProperties": false
}

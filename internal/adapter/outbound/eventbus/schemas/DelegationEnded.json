{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "DelegationEnded",
  "title": "DelegationEnded",
  "type": "object",
  "required": ["delegation_id", "tenant_id", "delegator_id", "delegate_id", "scope", "ended_reason", "actor_id"],
  "properties": {
    "delegation_id": { "type": "string", "format": "uuid" },
    "tenant_id":     { "type": "string", "format": "uuid" },
    "delegator_id":  { "type": "string", "format": "uuid" },
    "delegate_id":   { "type": "string", "format": "uuid" },
    "scope":         { "type": "string", "enum": ["all","department","tender"] },
    "scope_id":      { "type": "string", "format": "uuid" },
    "ended_reason":  { "type": "string", "enum": ["expired","cancelled","delegate_removed"] },
    "actor_id":      { "type": "string", "format": "uuid" }
  },
  "additionalProperties": false
}

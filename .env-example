# ─────────────────────────────────────────────────────────────────────────
# iam-org-membership — local dev environment (Phase 0)
# ─────────────────────────────────────────────────────────────────────────
# Copy to .env and adjust. `make setup` copies this file if .env is absent.
# Private modules require an SSH key registered with the BCBP org.
GOPRIVATE=github.com/BCBP-SOLUTIONS-FZC-LLC/*
GONOSUMDB=github.com/BCBP-SOLUTIONS-FZC-LLC/*

# ── Application ──────────────────────────────────────────────────────────
APP_NAME=iam-org-membership
# APP_ENV doubles as the metrics environment label: local|dev|test|staging|prod
# only ("production"/"development" are rejected at startup).
APP_ENV=dev
# Observability Standard domain label (required by platform-gincommon).
OBSERVABILITY_DOMAIN=iam
APP_PORT=8080
# /metrics is served on its own dedicated port/listener, separate from
# APP_PORT — see cmd/server/main.go's metricsServer.
METRICS_PORT=9090

# ── PostgreSQL ───────────────────────────────────────────────────────────
# make docker-up exposes PgBouncer on 5533 (transaction pooling) and direct
# Postgres on 5534. Sibling iam-user-profile2 uses 5433/5434 — offsetting
# our host ports lets both services run in parallel. Container-internal
# ports stay 5432 in both stacks; only the host publish differs.
DATABASE_URL=
PG_HOST=localhost
PG_PORT=5533
PG_USER=org_membership_app
PG_PASSWORD=devpassword
PG_DBNAME=org_membership
PG_SSLMODE=disable
PG_MAX_CONNS=20
PG_MIN_CONNS=0
PG_SLOW_QUERY_THRESHOLD=200ms
# Applied per transaction by pgcommon (SET LOCAL), never to migrations.
PG_STATEMENT_TIMEOUT=5s
PG_LOCK_TIMEOUT=2s
# cmd/reconciler only: per-statement bound for batch sweeps.
RECONCILER_STATEMENT_TIMEOUT=120s
PG_BOUNCER_MODE=true

# Direct Postgres for migrations (bypasses PgBouncer, MIG-1/CONFIG-2).
# Run as org_membership_migrator, the role that owns the schema.
MIGRATION_DATABASE_URL=postgres://org_membership_migrator:devpassword@localhost:5534/org_membership?sslmode=disable

# BYPASSRLS pool for reconciler jobs + cross-tenant metric exporters
# (RLS-4, §4.4), and PUB-1's resolve. Always org_membership_migrator, direct
# to Postgres (PgBouncer knows only the app role). Left empty it falls back
# to the app DSN, and cross-tenant queries (PUB-1 included) RLS-filter to 0
# rows.
SYSTEM_DATABASE_URL=postgres://org_membership_migrator:devpassword@localhost:5534/org_membership?sslmode=disable

# ── Valkey / Redis ───────────────────────────────────────────────────────
# make docker-up publishes Valkey on 6380 (sibling holds 6379).
# Production/staging MUST use rediss:// (TLS). Advisory cache only (CACHE-2/9).
VALKEY_URL=localhost:6380

# ── AWS SNS / SQS / Glue (floci in dev) ───────────────────────────────────
# Two SNS topics (LLD §7.3 — RoutingPublisher wraps both).
SNS_TOPIC_MEMBERSHIP_ARN=arn:aws:sns:ap-south-1:000000000000:iam-membership-events
SNS_TOPIC_TENANT_ARN=arn:aws:sns:ap-south-1:000000000000:iam-tenant-events

# Two SQS queues (LLD §7.1 — inbound lifecycle projections).
# `make docker-up` starts floci on host port 4567; the init hook
# (scripts/init-floci.sh) provisions the full §7.1/§7.3.2 topology.
SQS_TENANT_ORGM_QUEUE_URL=http://localhost:4567/000000000000/tenant-orgm-q
SQS_BILLING_ORGM_QUEUE_URL=http://localhost:4567/000000000000/billing-orgm-q
# Receive count at which platform-events forwards a message to its DLQ.
# Must stay below every inbound queue's RedrivePolicy maxReceiveCount (5).
SQS_MAX_RECEIVE_COUNT=4
# Consumer drain on shutdown and per-handler bound (handler < 30s visibility).
SQS_DRAIN_TIMEOUT=15s
SQS_HANDLER_TIMEOUT=20s
# platform_queue_depth / platform_dlq_depth sampling interval.
SQS_QUEUE_DEPTH_INTERVAL=60s
# catalog-orgm-q ← iam-catalog-events (iam-catalog-admin): DepartmentCatalogChanged
# clears om:departments; PlanCatalogChanged clears om:plans and retires cached I-8
# projections of the plan's tenants (LLD §6.3/§7.1, rev 2.39). Required in staging
# and production; optional locally (unset = consumer not started, caches TTL-only).
SQS_CATALOG_ORGM_QUEUE_URL=http://localhost:4567/000000000000/catalog-orgm-q

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4567

# Glue Schema Registry (SCHEMA-7) — one registry per SNS topic:
# iam-membership-events and iam-tenant-events each have their own. Floci
# includes Glue Schema Registry in its free tier (unlike LocalStack
# Community, which gated it behind Pro), so scripts/init-floci.sh provisions
# both registries and all 14 schemas on `make docker-up` — these are set by
# default so local dev runs the real Glue wire-format codec end-to-end.
# Leave a name empty to publish plain JSON (NoopCodec) on that topic instead
# — safe to combine with PG_BOUNCER_MODE=true either way, since the codec
# runs at SNS-publish time, never against outbox_events itself.
GLUE_REGISTRY_MEMBERSHIP_NAME=iam-membership-events
GLUE_REGISTRY_MEMBERSHIP_ARN=arn:aws:glue:ap-south-1:000000000000:registry/iam-membership-events
GLUE_REGISTRY_TENANT_NAME=iam-tenant-events
GLUE_REGISTRY_TENANT_ARN=arn:aws:glue:ap-south-1:000000000000:registry/iam-tenant-events

# ── schema-gov (LLD §7.3.1) ──────────────────────────────────────────────
# Used by make schema-* targets and CI schema-registry workflow.
SCHEMA_GOV_IMAGE=ghcr.io/bcbp-solutions-fzc-llc/platform-schemagov:0.4

# ── OpenTelemetry (read by platform-gincommon) ───────────────────────────
# The service name is APP_NAME (above); OTEL_SERVICE_NAME is not read.
# gincommon treats an EMPTY endpoint as unset and falls back to
# localhost:4317, and it does not read OTEL_TRACES_EXPORTER — so without a
# collector, local runs log failed span exports (spans still exist
# in-process; trace_id/request_id keep working). Run a collector on 4317,
# or set OTEL_EXPORTER_OTLP_ENDPOINT=none once on a platform-gincommon
# release that supports disabling export.
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACES_SAMPLER_RATIO=1.0
OTEL_PROPAGATOR_BAGGAGE=false
OTEL_TRACES_IGNORE_REMOTE_PARENT_SAMPLED=false

# ── Logging (read by platform-gincommon's logger) ────────────────────────
LOG_LEVEL=debug
LOG_SAMPLING=false

# ── Outbox runner ────────────────────────────────────────────────────────
OUTBOX_POLL_INTERVAL=500ms
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_DRAIN_TIMEOUT=30s
OUTBOX_PUBLISH_CONCURRENCY=4
OUTBOX_PUBLISH_TIMEOUT=10s
OUTBOX_STARTUP_JITTER=2s
OUTBOX_CLAIM_LEASE_DURATION=10m

# processed_events retention (PE-1 strictly > 7-day SQS lifetime, IDEMP-4).
PROCESSED_EVENTS_TTL_DAYS=8

# trial_signup_ledger retention (CR-4), pruned by trial-ledger-prune.
TRIAL_LEDGER_RETENTION_DAYS=730

# Valkey cache TTL for om:* keys (jitter is applied per-write). Advisory cache
# only (CACHE-2/9) — misses fall through to Postgres, correctness is unaffected.
CACHE_TTL_SECONDS=300

# ── Outbound service clients (LLD §18) ───────────────────────────────────
# Fail-open where noted in CLAUDE.md; timeouts default 3000ms.
WORKFLOW_SERVICE_BASE_URL=http://localhost:8082
WORKFLOW_TIMEOUT_MS=3000
# Shared secret the Workflow Execution Service requires in x-internal-token on
# every internal route. Leave blank in local dev (fail-open); set in
# staging/prod once the credential delivery mechanism is agreed with the
# Workflow team (see resp-iam-compat-2026-11-01 "One further finding").
WORKFLOW_INTERNAL_TOKEN=
REALM_PROVISIONER_BASE_URL=http://localhost:8083
REALM_PROVISIONER_TIMEOUT_MS=3000
# Catalog / Admin Config Service (ADR-0007 Wave 1, ✱NOT fail-open✱ — an
# empty/unreachable value surfaces catalog_unavailable rather than
# fabricating department/plan data; see internal/adapter/outbound/catalogadmin).
CATALOG_ADMIN_BASE_URL=http://localhost:8084
CATALOG_ADMIN_TIMEOUT_MS=3000
# Group Mapping / JIT Config Service (ADR-0007 Wave 2). I-10's mapping
# resolution fails OPEN (ADR-0007 Action Item 4): an empty/unreachable
# value falls through to the om:*:stale cache, or an empty resolution as
# a last resort — never a failed SAML login. See internal/adapter/outbound/
# groupmappingclient. Timeout default is 300ms (GM-I1's own p99 target is
# <=50ms; this is generous headroom, not a tight budget).
GROUP_MAPPING_BASE_URL=http://localhost:8085
GROUP_MAPPING_TIMEOUT_MS=300
# Delegation Service (ADR-0008 v2). §8.8.4's dept-scope pre-filter fails
# OPEN: an empty/unreachable value degrades to tenant-wide delegate-impact
# scoping rather than blocking the dept demotion/removal — see
# internal/adapter/outbound/delegationcheck.
# Side-by-side port convention: iam-delegation runs on 8086 locally so it
# does not collide with this service (8082) or iam-user-profile (8080).
# Set PORT=8086 in iam-delegation's .env when running both services together.
DELEGATION_BASE_URL=http://localhost:8086
# Raised from 300ms to 1000ms — 300ms was too tight under load or cold-start,
# causing frequent fallback to tenant-wide impact scoping. This is an
# admin-initiated path (not a hot read) so 1000ms is safe.
DELEGATION_TIMEOUT_MS=1000
# Token Service (AUTH-9). The membership-create (P-6/I-3) and role-grant
# (P-10/P-28) service-account-not-grantable check fails OPEN: an empty/
# unreachable value degrades to allowing the operation, since the primary
# guarantee is structural (composite FK bar, TR-8/DM-4) — see
# internal/adapter/outbound/tokenservice. Not a hot path (invite/
# reconcile-roles frequency), so a generous default timeout is fine.
# Side-by-side port convention: iam-token-service runs on 8087 locally so
# it does not collide with this service (8082) or any sibling above.
TOKEN_SERVICE_BASE_URL=http://localhost:8087
TOKEN_SERVICE_TIMEOUT_MS=1000

# iam-audit-log AL-5 direct-write (D-6: config.tenant_setting.changed,
# invitation.created, invitation.revoked, invitation.expired).
# Best-effort, fail-open — outage never surfaces to callers.
# Leave unset in dev to skip audit writes without breaking anything.
AUDIT_LOG_BASE_URL=http://localhost:8088
AUDIT_LOG_TIMEOUT_MS=3000

# ── Business timers (LLD §12) ────────────────────────────────────────────
INVITATION_EXPIRY_DAYS=7
SEAT_OVERAGE_GRACE_DAYS=30
SUBSCRIPTION_GRACE_DAYS=30
MAX_LIFECYCLE_EVENT_SKEW_SECONDS=300
INVITE_REINVITE_COOLDOWN_MINUTES=15
INVITE_MAX_PER_TENANT_PER_HOUR=60
INVITE_MAX_PER_ACTOR_PER_HOUR=10

# ── Internal route tenant binding ────────────────────────────────────────
# /api/v1/internal/tenants/:id/* always use the path tenant (BindPathTenant).
# false (default): a different x-tenant-id is overridden, logged as
#   tenant_header_path_mismatch and counted on
#   iam_org_membership_tenant_header_path_mismatch_total.
# true: the request is rejected with 400 TENANT_MISMATCH before the handler.
# Helm: iam.strictTenantPathValidation.
STRICT_TENANT_PATH_VALIDATION=false

# ── Docs surface (optional) ──────────────────────────────────────────────
DOCS_ENABLED=false
DOCS_AUTH_TOKEN=

# ── Reconciler metrics ───────────────────────────────────────────────────
# cmd/reconciler pushes each run's metrics to a Prometheus Pushgateway
# (grouped by cronjob). Empty skips the push.
PROMETHEUS_PUSHGATEWAY_URL=
